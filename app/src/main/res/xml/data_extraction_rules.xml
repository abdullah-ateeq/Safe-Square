<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and statistics live in Preferences DataStore and are safe to back up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
